# ==============================================================================
# VOCALIS - PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================

# GEMINI_API_KEY (Required)
# Gemini API key used server-side in Netlify Functions and Express backend.
# In Netlify: Site configuration > Environment variables > Add a variable
# Key: GEMINI_API_KEY
# Value: your_gemini_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# APP_URL (Optional)
# The canonical URL where this app is hosted (e.g. https://your-site.netlify.app)
APP_URL=https://your-site.netlify.app
